{
  "name": "Real-estate lead pipeline: 4 forms → CRM (find-or-create + tags) → follow-up task → email segments",
  "nodes": [
    {"parameters": {"httpMethod": "POST", "path": "lead-intake", "responseMode": "onReceived", "options": {}},
     "id": "1", "name": "Form webhook (open house · buyer · seller · contact)", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, 0]},
    {"parameters": {"assignments": {"assignments": [
        {"id": "a1", "name": "email", "value": "={{ ($json.body.email || '').toLowerCase().trim() }}", "type": "string"},
        {"id": "a2", "name": "phone", "value": "={{ ($json.body.phone || '').replace(/[^0-9+]/g, '') }}", "type": "string"},
        {"id": "a3", "name": "name", "value": "={{ $json.body.name || 'Unknown' }}", "type": "string"},
        {"id": "a4", "name": "form", "value": "={{ $json.body.form }}", "type": "string"},
        {"id": "a5", "name": "source", "value": "={{ ({'open_house':'Open house','buyer':'Website – buyer','seller':'Website – seller','contact':'Website – contact'})[$json.body.form] || 'Other' }}", "type": "string"},
        {"id": "a6", "name": "lead_type", "value": "={{ ({'open_house':'Buyer','buyer':'Buyer','seller':'Seller','contact':'Unqualified'})[$json.body.form] || 'Unqualified' }}", "type": "string"},
        {"id": "a7", "name": "stage", "value": "New", "type": "string"},
        {"id": "a8", "name": "notes", "value": "={{ $json.body.message || $json.body.property || '' }}", "type": "string"},
        {"id": "a9", "name": "received_at", "value": "={{ $now.toISO() }}", "type": "string"}
      ]}, "options": {}},
     "id": "2", "name": "Normalise + tag", "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [240, 0]},
    {"parameters": {"conditions": {"options": {"caseSensitive": false, "typeValidation": "loose"}, "combinator": "or", "conditions": [
        {"id": "c1", "leftValue": "={{ $json.email }}", "rightValue": "@", "operator": {"type": "string", "operation": "contains"}},
        {"id": "c2", "leftValue": "={{ $json.phone.length }}", "rightValue": 9, "operator": {"type": "number", "operation": "gte"}}
      ]}, "options": {}},
     "id": "3", "name": "Has email or phone?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [480, 0]},
    {"parameters": {"method": "GET", "url": "=https://api.lofty.com/v1/leads?email={{ encodeURIComponent($json.email) }}",
      "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "options": {}},
     "id": "4", "name": "Lofty: find contact", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [720, -120]},
    {"parameters": {"conditions": {"options": {"caseSensitive": false, "typeValidation": "loose"}, "combinator": "and", "conditions": [
        {"id": "c3", "leftValue": "={{ $json.total || 0 }}", "rightValue": 0, "operator": {"type": "number", "operation": "gt"}}
      ]}, "options": {}},
     "id": "5", "name": "Exists?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [960, -120]},
    {"parameters": {"method": "PATCH", "url": "=https://api.lofty.com/v1/leads/{{ $json.leads[0].id }}",
      "sendBody": true, "specifyBody": "json",
      "jsonBody": "={{ JSON.stringify({ tags: [$('Normalise + tag').item.json.source, $('Normalise + tag').item.json.lead_type, 'Stage: ' + $('Normalise + tag').item.json.stage], notes: $('Normalise + tag').item.json.notes }) }}",
      "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "options": {}},
     "id": "6", "name": "Lofty: update + add tags", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1200, -220]},
    {"parameters": {"method": "POST", "url": "https://api.lofty.com/v1/leads",
      "sendBody": true, "specifyBody": "json",
      "jsonBody": "={{ JSON.stringify({ name: $('Normalise + tag').item.json.name, email: $('Normalise + tag').item.json.email, phone: $('Normalise + tag').item.json.phone, source: $('Normalise + tag').item.json.source, tags: [$('Normalise + tag').item.json.source, $('Normalise + tag').item.json.lead_type, 'Stage: New'], notes: $('Normalise + tag').item.json.notes }) }}",
      "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "options": {}},
     "id": "7", "name": "Lofty: create contact", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1200, -20]},
    {"parameters": {"method": "POST", "url": "https://api.lofty.com/v1/tasks",
      "sendBody": true, "specifyBody": "json",
      "jsonBody": "={{ JSON.stringify({ leadId: $json.id || $json.leads?.[0]?.id, title: 'Follow up new ' + $('Normalise + tag').item.json.lead_type.toLowerCase() + ' lead (' + $('Normalise + tag').item.json.source + ')', dueAt: $now.plus({hours: 24}).toISO() }) }}",
      "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "options": {}},
     "id": "8", "name": "Lofty: follow-up task in 24 h", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1440, -120]},
    {"parameters": {"method": "POST", "url": "https://api.flodesk.com/v1/subscribers",
      "sendBody": true, "specifyBody": "json",
      "jsonBody": "={{ JSON.stringify({ email: $('Normalise + tag').item.json.email, first_name: $('Normalise + tag').item.json.name.split(' ')[0], segment_ids: [ ({'Buyer':'SEG_BUYER_NURTURE','Seller':'SEG_SELLER_NURTURE','Unqualified':'SEG_GENERAL'})[$('Normalise + tag').item.json.lead_type] ] }) }}",
      "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "options": {}},
     "id": "9", "name": "Flodesk: add to matching segment", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1680, -120]},
    {"parameters": {"operation": "append", "documentId": {"__rl": true, "mode": "list", "value": "REPLACE_WITH_SHEET_ID"},
      "sheetName": {"__rl": true, "mode": "list", "value": "Rejected"}, "columns": {"mappingMode": "autoMapInputData", "value": {}}, "options": {}},
     "id": "10", "name": "Log incomplete submission", "type": "n8n-nodes-base.googleSheets", "typeVersion": 4.5, "position": [720, 160]}
  ],
  "connections": {
    "Form webhook (open house · buyer · seller · contact)": {"main": [[{"node": "Normalise + tag", "type": "main", "index": 0}]]},
    "Normalise + tag": {"main": [[{"node": "Has email or phone?", "type": "main", "index": 0}]]},
    "Has email or phone?": {"main": [[{"node": "Lofty: find contact", "type": "main", "index": 0}], [{"node": "Log incomplete submission", "type": "main", "index": 0}]]},
    "Lofty: find contact": {"main": [[{"node": "Exists?", "type": "main", "index": 0}]]},
    "Exists?": {"main": [[{"node": "Lofty: update + add tags", "type": "main", "index": 0}], [{"node": "Lofty: create contact", "type": "main", "index": 0}]]},
    "Lofty: update + add tags": {"main": [[{"node": "Lofty: follow-up task in 24 h", "type": "main", "index": 0}]]},
    "Lofty: create contact": {"main": [[{"node": "Lofty: follow-up task in 24 h", "type": "main", "index": 0}]]},
    "Lofty: follow-up task in 24 h": {"main": [[{"node": "Flodesk: add to matching segment", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1"}
}
